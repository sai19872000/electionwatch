# ElectionWatch scraper env — copy to ~/factory/.env.electionwatch and fill in values.
# ~/factory/.env.electionwatch is gitignored via .env.* pattern in .gitignore.

# ECI results portal base path (confirm via smoke_probe.py on/after May 2):
ECI_BASE_PATH=AcResultGenMay2026

# Cloudflare R2 credentials:
R2_ACCOUNT_ID=your_cf_account_id
R2_BUCKET=ew-snapshots
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET=your_r2_secret_access_key

# Telegram chat ID for p0 scraper alerts:
TG_CHAT_ID=your_telegram_chat_id
