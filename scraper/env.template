# ElectionWatch scraper env — copy to ~/factory/.env.electionwatch and fill in values.
# ~/factory/.env.electionwatch is gitignored via .env.* pattern in .gitignore.

# ECI results portal base path (confirm via smoke_probe.py on/after May 2):
ECI_BASE_PATH=AcResultGenMay2026

# Cloudflare R2 credentials:
# R2_ENDPOINT format: https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cf_account_id.r2.cloudflarestorage.com
R2_BUCKET=ew-snapshots
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Telegram chat ID for p0 scraper alerts:
TG_CHAT_ID=your_telegram_chat_id

# CEO portal fallback base paths (NIC infra) — optional but recommended for resilience.
# Configure before counting day. Scraper tries ECI first; on 503/timeout falls back
# to CEO portal using the same ConstituencywiseResult-<code>.htm path structure.
# Example: CEO_BASE_S22=https://www.elections.tn.gov.in/AcResultGenMay2026
CEO_BASE_S03=
CEO_BASE_S11=
CEO_BASE_S22=
CEO_BASE_S25=
CEO_BASE_U06=
