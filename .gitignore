# Node / Next.js
node_modules/
.next/
out/
.turbo/

# CF Workers / Wrangler
.wrangler/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Logs
*.log
logs/

# Env / secrets — never commit
.env
.env.*
!.env.template
!env.template

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build artifacts (general)
build/
*.tsbuildinfo

# web/ dist excluded (generated by next build)
web/dist/
web/.next/

# data/dist is committed — these are content-hashed static artifacts
# deployed to R2; we want them tracked so CF Pages can pick them up
# without a separate build step.
!data/dist/

# Raw source shapefiles — large, not needed in repo
data/raw/
